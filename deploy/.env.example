# 复制为 .env 后填写；真实 .env 不要提交。

# 远程基础设施地址
DB_HOST=your-server-host
DB_PORT=3307
DB_NAME=hmdp
DB_USERNAME=root
DB_PASSWORD=your-database-password
REDIS_HOST=your-server-host
REDIS_PORT=6390
REDIS_PASSWORD=your-redis-password
RABBITMQ_HOST=your-server-host
RABBITMQ_PORT=5670
RABBITMQ_USERNAME=hmdp
RABBITMQ_PASSWORD=your-rabbitmq-password
POSTGRES_HOST=your-server-host
POSTGRES_PORT=5438
POSTGRES_DB=hmdp
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=your-postgres-password

# AI / 安全配置
DEEPSEEK_API_KEY=your-deepseek-api-key
JWT_SECRET=your-jwt-secret-at-least-32-chars
ID_OBFUSCATOR_SALT=your-random-id-salt-at-least-32-chars

# 前端构建时注入
VITE_AMAP_JS_KEY=your-amap-js-key

# 服务器已有 Ollama 时使用宿主机地址；否则改为云端 Embedding 服务。
# 当前目标服务器资源有限，默认不启用 RAG 文档监听。
RAG_DOCUMENT_ENABLED=false
EMBEDDING_BASE_URL=http://host.docker.internal:11434/v1
EMBEDDING_API_KEY=ollama
EMBEDDING_MODEL=bge-m3

# XXL-JOB 如暂不接入可保持 false
XXL_JOB_ENABLED=false
XXL_JOB_ADMIN_URL=http://your-server-host:8080/xxl-job-admin
XXL_JOB_ACCESS_TOKEN=default_token
XXL_JOB_EXECUTOR_IP=your-server-host
